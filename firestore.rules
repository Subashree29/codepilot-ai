rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Each user can only read/write their own profile document.
    // Progress + chat history live as subcollections under the same doc,
    // so this one rule protects all of it via recursive match.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /progress/{roadmapId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Chat history keyed by uid at the top level (chat_history/{uid}/messages/{id})
    match /chat_history/{uid}/messages/{messageId} {
      allow read, write: if isOwner(uid);
    }

    // Content collections: readable by any signed-in user, writable only
    // via the Firebase Console / an admin Cloud Function (service account
    // bypasses rules). Lock writes down for client SDKs.
    match /roadmaps/{roadmapId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /achievements/{achievementId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    // Broadcast feed (new lesson/roadmap/challenge alerts) - written only
    // by the Cloud Functions in /functions/index.js via the Admin SDK,
    // which bypasses these rules entirely. Clients only ever read.
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
